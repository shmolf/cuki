{
  "name": "cuki",
  "version": "2.0.3",
  "description": "Cookie Data Library",
  "types": "./dist/cuki.d.ts",
  "main": "dist/cuki.umd.js",
  "module": "dist/cuki.js",
  "browser": "dist/cuki.umd.js",
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shmolf/cuki.git"
  },
  "keywords": [
    "cookie",
    "🍪",
    "cuki"
  ],
  "author": "Nicholas Browning",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shmolf/cuki/issues"
  },
  "homepage": "https://github.com/shmolf/cuki#readme",
  "browserslist": [
    "last 1 version",
    "> 1%",
    "IE 11"
  ],
  "files": [
    "README.md",
    "package.json",
    "LICENSE",
    "dist/**/*",
    "docs/**/*",
    "src/**/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-angular": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "globals": "^17.7.0",
    "husky": "^6.0.0",
    "jsdom": "^29.1.1",
    "pinst": "^2.1.6",
    "semantic-release": "^25.0.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
