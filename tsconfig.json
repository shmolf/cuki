{
  "compilerOptions": {
      "module": "commonjs",
      "noImplicitAny": true,
      "strictNullChecks": true,
      "removeComments": true,
      "preserveConstEnums": true,
      "sourceMap": true,
      "declaration": true,
      "esModuleInterop": true,
      "rootDir": "./src",
      "outDir": "dist",
      "lib": ["esnext", "DOM"]
  },
  "include": ["src/**/*"],
  "watchOptions": {
    "excludeDirectories": ["dist"]
  }
}
